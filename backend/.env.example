# Docker Compose reads backend/.env; direct runs require exported variables.
DB_PATH=./social-network.db
PORT=8080
FRONTEND_URL=http://localhost:3000
# Immutable IDs of existing accounts, comma-separated. Never derive roles from a mutable email.
MODERATOR_USER_IDS=
# Optional first owner on a fresh database only. Choose your own private credentials.
# Rebuilds preserve this account; these settings never reset existing accounts.
BOOTSTRAP_MODERATOR_EMAIL=
BOOTSTRAP_MODERATOR_PASSWORD=
# Password recovery: configure your mail provider here. Keep credentials out of Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Only for a local test SMTP server; production requires TLS.
SMTP_ALLOW_INSECURE=false

# Google OAuth web client. The redirect must match Google Cloud Console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/google/callback
